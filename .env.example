# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here

# Prefix command configuration (default: !)
PREFIX=!

# Development Guild ID (used by default when deploying slash commands)
GUILD_ID=your_test_guild_id_here

# Authorized Creator / Admin Discord User IDs (comma-separated snowflakes for /knowledge management)
# BOT_OWNER_IDS=your_discord_user_id_here

# Feedback & Reports System (!feedback)
FEEDBACK_CHANNEL_ID=
# FEEDBACK_STAFF_ROLE_IDS=your_staff_role_id_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Real-Time Web Search Configuration (Tavily API — used selectively by /ai & !ai)
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL=900
WEB_SEARCH_COOLDOWN_SECONDS=10
WEB_SEARCH_TIMEOUT_MS=15000

# Optional Genius Official API Token (metadata & Genius links for /lyrics; /lyrics works without it)
# GENIUS_API_KEY=your_genius_client_access_token_here

# Media Downloader Configuration (RapidAPI — /download & messageCreate Auto-Downloader)
# RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=social-media-video-downloader.p.rapidapi.com
# Instagram endpoint resmi (Get-Instagram-Media-Post-Details, opsional override):
# RAPIDAPI_INSTAGRAM_ENDPOINT=https://social-media-video-downloader.p.rapidapi.com/instagram/v3/media/post/details
# Format video opsional untuk Instagram (contoh: 720p):
# RAPIDAPI_RENDERABLE_FORMATS=720p
# TikTok endpoint resmi (Get-TikTok-Post-Details, opsional override):
# RAPIDAPI_TIKTOK_ENDPOINT=https://social-media-video-downloader.p.rapidapi.com/tiktok/v3/post/details
DOWNLOAD_MAX_SIZE_MB=25
DOWNLOAD_TIMEOUT_MS=25000
DOWNLOAD_MAX_CONCURRENT=3
DOWNLOAD_COOLDOWN_SECONDS=10
# DOWNLOAD_TEMP_DIR=/tmp/midwave-downloads
