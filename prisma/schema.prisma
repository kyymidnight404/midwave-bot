generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AutoRole {
  id        Int      @id @default(autoincrement())
  guildId   String
  roleId    String
  createdAt DateTime @default(now())

  @@unique([guildId, roleId])
  @@index([guildId])
}
