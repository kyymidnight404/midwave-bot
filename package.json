{
  "name": "midwave",
  "version": "1.0.0",
  "description": "Midwave Discord Game Bot — lightweight in-memory MVP with 7 Solo & Multiplayer mini-games",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "deploy": "node --env-file=.env deploy-commands.js",
    "deploy:preview": "node --env-file=.env deploy-commands.js --preview",
    "deploy:global": "node --env-file=.env deploy-commands.js --global",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate && node -e \"const fs = require('fs'); const { execSync } = require('child_process'); if (fs.existsSync('.env')) execSync('npx prisma migrate deploy', { stdio: 'inherit' });\"",
    "test": "node --test \"tests/**/*.test.js\"",
    "bench:c4": "node scripts/bench-c4.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "games",
    "midwave"
  ],
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@napi-rs/canvas": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "axios": "^1.21.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "discord.js": "^14.28.1"
  },
  "allowScripts": {
    "@google/genai@2.32.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
